<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 本机是 .NET 11 SDK。若要在只有 .NET 10 运行时的机器上构建，改回 net10.0-windows 即可，
         代码不含 11 专属 API -->
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>TaskMgrLite</AssemblyName>
    <RootNamespace>TaskMgrLite</RootNamespace>
    <Version>0.1.05</Version>
    <FileVersion>0.1.05.0</FileVersion>

    <!-- exe 与任务栏图标；app.ico 含 16~256 九档，窗口图标另以 Resource 引用 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- 自包含 R2R 发布参数放在 scripts/build.ps1 里，避免日常 build 变慢 -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window.Icon 通过 pack URI "/Assets/app.ico" 引用，必须作为 Resource 编译进程序集 -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
